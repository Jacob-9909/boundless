# /etc/systemd/system/boundless.service
# Install: sudo cp deploy/boundless.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now boundless
[Unit]
Description=Boundless (Next.js standalone)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/boundless/app
EnvironmentFile=/home/ubuntu/boundless/.env
Environment=NODE_ENV=production PORT=8040 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
