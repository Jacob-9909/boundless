# PostgreSQL. Local docker or PGlite; production is Neon (docs/DEPLOY.md). Schema "boundless".
DATABASE_URL=postgres://boundless:password@127.0.0.1:5432/postgres
# Long random string: openssl rand -base64 32
SESSION_SECRET=
# Gmail SMTP for sign-in codes (Google app password). Empty in dev = code printed to the console.
EMAIL_SENDER=
EMAIL_PASSWORD=
# Comma-separated emails that can open /admin (moderation queue).
ADMIN_EMAILS=
# Optional: NVIDIA NIM key (build.nvidia.com) for the AI summary of solved posts and the AI check while writing.
NVIDIA_API_KEY=

# Demo deployments only: show sign-in codes on screen for fictional @example.com accounts.
DEMO_LOGIN=

# Daily cleanup (/api/cron/cleanup). Vercel Cron sends it as a Bearer token; without it the route refuses.
CRON_SECRET=
# Optional: Slack or Discord incoming webhook for server errors (src/lib/log.ts).
ALERT_WEBHOOK_URL=
# Optional: privacy contact shown on /policy (a team address, not a personal one).
PRIVACY_CONTACT=
# Photos: connecting a Vercel Blob store sets BLOB_STORE_ID (OIDC) on Vercel. Elsewhere, a read-write token
# (BLOB_READ_WRITE_TOKEN) does the same. Without either, photos are stored in Postgres.
