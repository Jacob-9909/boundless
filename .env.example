# PostgreSQL. Production: oracle_vm, schema "boundless", role "boundless".
DATABASE_URL=postgres://boundless:password@127.0.0.1:5432/postgres
# Long random string: openssl rand -base64 32
SESSION_SECRET=
# Gmail SMTP for sign-in codes (Google app password). Empty in dev = code printed to the console.
EMAIL_SENDER=
EMAIL_PASSWORD=
# Comma-separated emails that can open /admin (moderation queue).
ADMIN_EMAILS=
# Optional: NVIDIA NIM key (build.nvidia.com) for the AI summary of solved posts and the AI check while writing.
NVIDIA_API_KEY=

# Demo deployments only: show sign-in codes on screen for fictional @example.com accounts.
DEMO_LOGIN=
